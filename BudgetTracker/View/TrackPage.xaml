<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BudgetTracker.View.TrackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BudgetTracker.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Root: background image fills the page -->
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/BankImage.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Overlay for content -->
        <Grid>
            <!-- Two-row layout: header (Back), body (form card) -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Back button in header -->
            <Grid Grid.Row="0">
                <Button
                    x:Name="ExitButton"
                    Command="{Binding GoBackCommand}"
                    Width="100"
                    Height="50"
                    Margin="16"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    FontFamily="/Assets/Fonts/PressStart2P-Regular.ttf#Press Start 2P"
                    Content="Back"
                    FontSize="10"
                    Background="DarkRed"
                    BorderBrush="DimGray"
                    BorderThickness="2"
                    Foreground="Gold"/>
            </Grid>

            <!-- Centering grid for the card -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card: centered, fixed width, background image -->
                <Border Grid.Column="1"
                        Margin="24"
                        Padding="24"
                        CornerRadius="16"
                        BorderBrush="#66000000"
                        BorderThickness="1">

                    <Border.Background>
                        <!-- Overlay your panel art -->
                        <ImageBrush ImageSource="/Assets/BankOverView.png" Stretch="Fill" AlignmentX="Center" AlignmentY="Center" />
                    </Border.Background>

                    <!-- Form layout -->
                    <Grid MaxWidth="1200" MinWidth="850" MaxHeight="700" RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>   <!-- Budget display -->
                            
                            <RowDefinition Height="*"/>   <!-- Category -->

                            <RowDefinition Height="*"/>  <!-- Money -->

                            <RowDefinition Height="*"/>  <!-- Date -->

                            <RowDefinition Height="*"/>  <!-- Submit -->
                            
                        </Grid.RowDefinitions>

                        <!-- Budget -->
                        <TextBlock Grid.Row="0"
                                   HorizontalAlignment="Center"
                                   FontFamily="/Assets/Fonts/PressStart2P-Regular.ttf#Press Start 2P"
                                   Text="Hi {Binding UserBudget}"
                                   Foreground="Gold"
                                   FontSize="18"
                                   TextWrapping="Wrap"
                                   
                                   />

                        <!-- Category -->
                        <ComboBox Grid.Row="1"
                                  Width="415"
                                  HorizontalAlignment="Center"
                                  FontFamily="/Assets/Fonts/PressStart2P-Regular.ttf#Press Start 2P"
                                  PlaceholderText="Select a Category">
                            <ComboBoxItem Content="Food (Eating Out)"/>
                            <ComboBoxItem Content="Food (Groceries)"/>
                            <ComboBoxItem Content="House Supplies"/>
                            <ComboBoxItem Content="Entertainment"/>
                            <ComboBoxItem Content="Education"/>
                            <ComboBoxItem Content="Others"/>
                        </ComboBox>

                        <!-- Money Spent -->
                        <TextBox Grid.Row="2"
                                 Width="415"
                                 Height="150"
                                 HorizontalAlignment="Center"
                                 FontFamily="/Assets/Fonts/PressStart2P-Regular.ttf#Press Start 2P"
                                 PlaceholderText="00.00"
                                 FontSize="50"
                                 TextAlignment="Center">
                            <TextBox.Header>
                                <TextBlock FontFamily="/Assets/Fonts/PressStart2P-Regular.ttf#Press Start 2P"
                                           Text="Enter The Price"
                                           Foreground="Gold"
                                           FontSize="15"/>
                            </TextBox.Header>
                        </TextBox>

                        <!-- Date -->
                        <CalendarDatePicker Grid.Row="3"
                                            x:Name="MyDatePicker"
                                            Width="415"
                                            HorizontalAlignment="Center"
                                            PlaceholderText="Select a date"
                                            FontFamily="/Assets/Fonts/PressStart2P-Regular.ttf#Press Start 2P">
                            <CalendarDatePicker.Header>
                                <TextBlock Text="Purchase Date"
                                           Foreground="Gold"
                                           FontFamily="/Assets/Fonts/PressStart2P-Regular.ttf#Press Start 2P"/>
                            </CalendarDatePicker.Header>
                        </CalendarDatePicker>

                        <!-- Submit -->
                        <Button Grid.Row="4"
                                Content="Submit"
                                Width="415"
                                HorizontalAlignment="Center"
                                FontFamily="/Assets/Fonts/PressStart2P-Regular.ttf#Press Start 2P"
                                Background="DarkRed"
                                BorderBrush="DimGray"
                                BorderThickness="2"
                                Foreground="Gold"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
